{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/dinner-campaigns",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/membership-compliance",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/dr-sal-location-release",
      "schedule": "5 16 * * *"
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
